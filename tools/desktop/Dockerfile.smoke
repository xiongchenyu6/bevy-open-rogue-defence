# Isolated runtime test environment: no Rust, Nix or game source checkout.
FROM registry.gitlab.steamos.cloud/steamrt/sniper/platform@sha256:8cd1bdfc418afd8b019a69d6f5a9305865a5f3bb5554102006fdb8f6853d5f67
RUN sed -i 's@http://deb.debian.org/debian-security@https://archive.debian.org/debian-security@g; s@http://archive.debian.org@https://archive.debian.org@g' /etc/apt/sources.list \
    && apt-get update && apt-get install -y --no-install-recommends \
    xvfb openbox xdotool imagemagick mesa-vulkan-drivers libvulkan1 python3 \
    && rm -rf /var/lib/apt/lists/*
